# Supabase project configuration (Vite reads VITE_-prefixed vars at build time).
# For Cloudflare Pages, set these as build environment variables in the dashboard.
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<your-project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"

# Used by the local seed scripts (scripts/*.mjs)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"

# Migration to a dedicated project (used by scripts/import-to-new-project.mjs)
NEW_SUPABASE_URL="https://<new-ref>.supabase.co"
NEW_SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
