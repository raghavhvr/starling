{
  // Cloudflare Workers static-assets deployment for the Starling SPA.
  // `wrangler deploy` uploads ./dist as static assets; single-page-application
  // not_found_handling serves index.html for deep links like /measurement.
  "name": "starling",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
